Import('env', 'arch', 'common', 'messaging')

if arch == 'Darwin':
  env = env.Clone(FRAMEWORKS=['CoreFoundation', 'IOKit', 'Security'])

libs = [common, messaging, 'pthread', 'usb-1.0', 'z']
panda = env.Library('panda', ['panda.cc', 'usb.cc'] + ([] if arch == 'Darwin' else ['spi.cc']))

env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

if GetOption('extras'):
  env.Program('tests/test_pandad_canprotocol', ['tests/test_pandad_canprotocol.cc'], LIBS=[panda] + libs)
  env.Program('tests/test_panda_rules', ['tests/test_panda_rules.cc', 'panda_safety.cc'], LIBS=[panda] + libs)
