{
  "id": "sp_engagement",
  "name": "SP Engagement",
  "version": "1.0.0",
  "api": 1,
  "use": "onroad",
  "category": "engagement",
  "entry": "plugin:SpEngagement",
  "author": "sunnypilot",
  "description": "SP's own ordinary state machine and MADS through the shared host guards. Always on; another owner of role:engagement.state replaces it.",
  "priority": 10000,
  "enable_param": null,
  "claims": [
    "role:engagement.state"
  ],
  "params": {},
  "settings": [
    {
      "key": "MadsMainCruiseAllowed",
      "label": "Toggle with Main Cruise"
    },
    {
      "key": "MadsUnifiedEngagementMode",
      "label": "Unified Engagement Mode (UEM)"
    },
    {
      "key": "MadsSteeringMode",
      "label": "Steering Mode on Brake Pedal",
      "choices": [
        [
          "Remain Active",
          0
        ],
        [
          "Pause",
          1
        ],
        [
          "Disengage",
          2
        ]
      ]
    }
  ]
}
